{
  "name": "deep-worker",
  "version": "0.1.0",
  "description": "Self-hosted, multi-user Agent workspace (deep-worker-main reproduction with Pi SDK).",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "pi-runner",
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev": "npm run dev -w server",
    "container:build": "docker build -t deep-worker-pi:latest -f container/Dockerfile .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  }
}
